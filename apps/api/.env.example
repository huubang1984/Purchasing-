# apps/api — cấu hình môi trường cho `pnpm api:dev` (ADR-021, S1.11).
# Mọi giá trị dưới đây là CHỖ TRỐNG, không phải bí mật. Sao chép thành `.env` (đã gitignore) rồi điền.
# Sinh một khoá 32 byte:   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Sinh khoá ký P-256:      node -e "console.log(require('crypto').generateKeyPairSync('ec',{namedCurve:'prime256v1'}).privateKey.export({type:'pkcs8',format:'der'}).toString('base64'))"
# Đọc bằng:                 set -a; . ./apps/api/.env; set +a; pnpm api:dev      (bash)

# Role ĐĂNG NHẬP, thành viên của app_api (hardening.always.sql, CAP_HOP_LE). Pool tự SET ROLE app_api.
#   CREATE ROLE app_api_login LOGIN PASSWORD '...' IN ROLE app_api;
TRUSTPROCURE_DATABASE_URL=postgres://app_api_login:<mat-khau>@127.0.0.1:5432/trustprocure
TRUSTPROCURE_DB_POOL_MAX=10

TRUSTPROCURE_LISTEN_HOST=127.0.0.1
TRUSTPROCURE_LISTEN_PORT=8080

# Gốc URL công khai — nơi /login#<token> và /i#<token> trỏ về. https:// ở mọi nơi ngoài localhost.
TRUSTPROCURE_PUBLIC_BASE_URL=http://localhost:3000
# Origin của ứng dụng web được phép gửi yêu cầu không-GET kèm cookie (review M-3). Rỗng = mọi trình duyệt bị 403.
TRUSTPROCURE_ALLOWED_ORIGINS=http://localhost:3000
# CIDR của proxy/LB đứng trước api (sổ nợ 41). Rỗng = không proxy, X-Forwarded-For bị bỏ qua. Ví dụ: 10.0.0.0/8,fd00::/8
# TRUSTPROCURE_TRUSTED_PROXIES=

# Hôm nay chỉ có "local-dev" (không KMS). Giá trị khác ⇒ tiến trình từ chối khởi động, không rơi về bản dev.
TRUSTPROCURE_KEY_ADAPTER=local-dev
# Ba vòng khoá 32 byte, ĐÔI MỘT KHÁC NHAU (tiến trình kiểm lúc khởi động). Dạng: <phiên bản>=<base64>[,<phiên bản>=<base64>]
TRUSTPROCURE_MASTER_KEYS=v1=<base64-32-byte>
TRUSTPROCURE_MASTER_KEY_ACTIVE=v1
TRUSTPROCURE_TOTP_MASTER_KEYS=t1=<base64-32-byte-khac>
TRUSTPROCURE_TOTP_MASTER_KEY_ACTIVE=t1
TRUSTPROCURE_OTP_PEPPERS=p1=<base64-32-byte-khac-nua>
TRUSTPROCURE_OTP_PEPPER_ACTIVE=p1
# Khoá ký biên nhận: ECDSA P-256, PKCS8 DER base64. Xoay khoá = THÊM kid mới rồi đổi ACTIVE, không bỏ kid cũ (ADR-011 mục 3).
TRUSTPROCURE_RECEIPT_SIGNING_KEYS=ky-2026=<base64-pkcs8-der>
TRUSTPROCURE_RECEIPT_SIGNING_ACTIVE=ky-2026

# Hôm nay chỉ có "dev-mailbox": mỗi tin (link đăng nhập, link mời, OTP) là một tệp JSON trong thư mục dưới.
# Đường dẫn phải TUYỆT ĐỐI và nên nằm NGOÀI cây repo — tệp chứa token và mã OTP dạng rõ.
TRUSTPROCURE_SENDER_ADAPTER=dev-mailbox
TRUSTPROCURE_DEV_MAILBOX_DIR=/tmp/trustprocure-hop-thu-dev

# Tuỳ chọn: trần thời gian cho mỗi việc sau commit (gửi tin), ms. Mặc định 5000.
# TRUSTPROCURE_AFTER_COMMIT_TIMEOUT_MS=5000

# [review H6-1] BẮT BUỘC: danh sách CIDR của proxy/LB đứng trước, hoặc `direct` khi không có.
# Bỏ trống không còn là mặc định — bucket theo người gọi là TOÀN CỤC (042), nên một lần quên
# gộp mọi khách vào một địa chỉ, và bán kính của lần gộp ấy là cả nền tảng.
TRUSTPROCURE_TRUSTED_PROXIES=direct

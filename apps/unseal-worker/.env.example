# apps/unseal-worker — cấu hình môi trường cho `pnpm worker:dev` (ADR-021, ADR-040, khoản 116).
# Mọi giá trị dưới đây là CHỖ TRỐNG, không phải bí mật. Sao chép thành `.env` (đã gitignore) rồi điền.
# Sinh một khoá 32 byte:   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Đọc bằng:                 set -a; . ./apps/unseal-worker/.env; set +a; pnpm worker:dev      (bash)
#
# TIẾN TRÌNH NÀY LÀ TIẾN TRÌNH DUY NHẤT GIẢI MÃ ĐƯỢC PHONG BÌ THẦU (ADR-006). Nó cố ý KHÔNG đọc
# TRUSTPROCURE_TOTP_MASTER_KEYS, TRUSTPROCURE_OTP_PEPPERS hay TRUSTPROCURE_RECEIPT_SIGNING_KEYS —
# một tiến trình vừa mở được phong bì vừa mở được bí mật TOTP là đúng thứ G1 dựng hai vòng khoá
# riêng để chặn. Đặt chúng ở đây cũng vô ích: `cau-hinh.ts` không đọc.

# Role ĐĂNG NHẬP, thành viên của app_unseal (hardening.always.sql, CAP_HOP_LE). Pool tự đổi sang app_unseal.
# Vai này KHÔNG do migration tạo — người vận hành tạo, cùng khuôn app_api_login:
#   CREATE ROLE app_unseal_login LOGIN PASSWORD '...' IN ROLE app_unseal;
TRUSTPROCURE_DATABASE_URL=postgres://app_unseal_login:<mat-khau>@127.0.0.1:5432/trustprocure
# Tiến trình mở tới 2 × giá trị này kết nối CSDL: pool nghiệp vụ và auditPool cùng cỡ (khoản 121).
# Đặt max_connections của máy chủ đủ cho mọi tiến trình api, cộng worker và lần migrate().
TRUSTPROCURE_DB_POOL_MAX=10

# Hôm nay chỉ có "local-dev" (không KMS). Giá trị khác ⇒ tiến trình từ chối khởi động, không rơi về bản dev.
TRUSTPROCURE_KEY_ADAPTER=local-dev
# VÒNG KHOÁ CHÍNH BỌC KHOÁ RIÊNG RFQ (ADR-019) — phải KHỚP vòng mà `apps/api` dùng để BỌC, nếu
# không thì mở bọc hỏng lúc chạy job chứ không hỏng lúc khởi động. Dạng: <phiên bản>=<base64>[,...]
TRUSTPROCURE_MASTER_KEYS=v1=<base64-32-byte>
TRUSTPROCURE_MASTER_KEY_ACTIVE=v1

# Cổng GỬI cảnh báo break-glass. KHÔNG có mặc định: một mặc định "ghi log cho có" là đúng thứ làm
# người ta tưởng cảnh báo đã tới tay ai đó (composition.ts). Hôm nay chỉ có "dev-file".
TRUSTPROCURE_ALERT_ADAPTER=dev-file
# Thư mục nhận cảnh báo, mỗi cảnh báo một tệp JSON. TUYỆT ĐỐI và nên nằm NGOÀI cây repo: tệp nói
# ra rằng một gói thầu cụ thể đang bị mở ngoài quy trình.
TRUSTPROCURE_ALERT_DIR=/tmp/trustprocure-canh-bao-dev

# Tuỳ chọn: nhịp poll của runner, ms (100–60000). Mặc định 1000.
# TRUSTPROCURE_OUTBOX_POLL_MS=1000

{
  "name": "trustprocure",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.0.0", "pnpm": ">=9.0.0" },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "depcruise": "depcruise packages apps tools tests --config .dependency-cruiser.cjs",
    "t0": "pnpm typecheck && pnpm lint && pnpm depcruise",
    "test": "vitest run --exclude \"**/*.int.test.ts\"",
    "test:int": "vitest run int.test",
    "test:all": "vitest run",
    "bench:keys": "node --experimental-transform-types --import ./tools/bench-keyprovider/register-ts-resolve.mjs tools/bench-keyprovider/src/index.ts"
  },
  "devDependencies": {
    "@types/node": "^22.7.0",
    "@types/pg": "^8.11.0",
    "dependency-cruiser": "^16.4.0",
    "eslint": "^9.12.0",
    "fast-check": "^3.22.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.8.0",
    "vitest": "^2.1.0"
  }
}
